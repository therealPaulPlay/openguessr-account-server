# Database
DB_HOST="your-database-ip-or-domain"
DB_PORT=3306
DB_USER="your-database-user"
DB_PASSWORD="your-database-password"
DB_DATABASE="openguessrmysql"

# JWT secret
JWT_SECRET="your-secret"
JWT_RESET_SECRET="your-reset-secret"

# OAuth
GOOGLE_OAUTH_CLIENT_ID="your-oauth-id"
GOOGLE_OAUTH_CLIENT_SECRET="your-oauth-secret"
APPLE_TEAM_ID="your-apple-team-id"
APPLE_KEY_ID="your-apple-key-id"
APPLE_PRIVATE_KEY="your-apple-private-key"

# Email
EMAIL_HOST="smtp.example.com"
EMAIL_USER="email@example.com"
EMAIL_PASS="your-email-password"

# Turnstile
TURNSTILE_SECRET="your-turnstile-secret"

# Stripe
STRIPE_KEY="your-stripe-secret"
STRIPE_TEST_KEY="your-stripe-test-key"
STRIPE_WEBHOOK_SECRET="webhook-secret"

# OpenReport
REPORT_SECRET="your-report-secret"
REPORT_APP_ID=0
REPORT_WEBHOOK_SECRET="your-webhook-report-secret"

# S3 (DigitalOcean Spaces)
SPACES_ACCESS_KEY_ID="your-access-key-id"
SPACES_SECRET_ACCESS_KEY="your-secret-access-key"
SPACES_BUCKET_NAME="paulplay-storage-1"

# Discord
DISCORD_APP_ID="your-discord-app-id"
DISCORD_TOKEN="your-discord-token"
DISCORD_PUBLIC_KEY="your-discord-public-key"

# OpenRouter
OPENROUTER_API_KEY="your-openrouter-key"
OPENROUTER_MODEL="openai/gpt-5.6-luna"

# Y8 Games
Y8_GAMES_APP_ID="your-y8-games-app-id"
